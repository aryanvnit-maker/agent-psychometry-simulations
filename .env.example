GEMINI_API_KEY=your_key_here

# Only required for cross-model replication (run_cross_model.py --provider anthropic)
ANTHROPIC_API_KEY=your_key_here

# Supabase — Project Settings → Database → Connection string → URI (Transaction pooler, port 6543)
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Worker model — overridden by run_cross_model.py at runtime
MODEL=gemini-2.5-flash
MODEL_PROVIDER=gemini        # gemini | anthropic
TEMPERATURE=0.0
AGENT_TOKEN_BUDGET=800
