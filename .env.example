# ── Minimal setup (Phases 1, 5, 6, 8, reproduce.py) ──────────────────────────
GEMINI_API_KEY=your_key_here
MODEL=gemini-2.5-flash
MODEL_PROVIDER=gemini        # gemini | anthropic | xai
TEMPERATURE=0.0
# Reasoning models (grok-*-reasoning, gemini-2.5-*) consume tokens on internal
# chain-of-thought before output — use 8000+ to avoid collapsed responses.
AGENT_TOKEN_BUDGET=4000

# Judge model — always Gemini regardless of worker MODEL setting
JUDGE_MODEL=gemini-2.5-flash

# ── Cross-model replication (run_cross_model.py --provider anthropic) ─────────
ANTHROPIC_API_KEY=your_key_here

# ── Phase 9 only: Kalibr vs Grok multi-agent panel ───────────────────────────
# Uncomment and fill in to run Phase 9. Set MODEL_PROVIDER=xai above.
# XAI_API_KEY=your_key_here
# MODEL=grok-4.20-0309-reasoning
# MODEL_PROVIDER=xai
# GROK_PANEL_MODEL=grok-4.20-multi-agent-0309
# AGENT_TOKEN_BUDGET=8000

# ── Optional: Supabase telemetry (Phase 1+2 only) ────────────────────────────
# DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
