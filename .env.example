GEMINI_API_KEY=your_key_here

# Only required for cross-model replication (run_cross_model.py --provider anthropic)
ANTHROPIC_API_KEY=your_key_here

# Required for Phase 9 (Kalibr vs Grok multi-agent panel)
XAI_API_KEY=your_key_here
# Grok base model for kalibr-chain condition (2 calls, our orchestration)
# Must be same generation as panel model for a fair comparison
# Use non-reasoning variant — same generation as panel, no reasoning-token advantage
MODEL=grok-4.20-0309-non-reasoning
MODEL_PROVIDER=xai
# Grok panel model for grok-panel condition (1 call, xAI's internal orchestration)
# Uses Responses API (client.responses.create), NOT /v1/chat/completions
# NOTE: panel has lower rate limits (450 RPM / 2.5M TPM) — runs will be slower
GROK_PANEL_MODEL=grok-4.20-multi-agent-0309

# Supabase — Project Settings → Database → Connection string → URI (Transaction pooler, port 6543)
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Worker model — overridden by run_cross_model.py at runtime
MODEL=gemini-2.5-flash
MODEL_PROVIDER=gemini        # gemini | anthropic
TEMPERATURE=0.0
AGENT_TOKEN_BUDGET=800
